# Configuration for oura-mcp-server. Placeholder values only.
# On Vercel, set these under Project > Settings > Environment Variables.
# For local testing you may copy this file to .env, but NEVER commit a real .env file.

# Required. Long random string: letters, digits, "-" and "_" only; at least 16, ideally 32+ characters.
# It is part of your private connector URL: https://<your-app>.vercel.app/oura/<OURA_PATH_SECRET>/mcp
OURA_PATH_SECRET=replace-with-a-long-random-string

# Required. Your time zone (IANA name). Decides what "today" and "last night" mean.
# Examples: Europe/London, America/New_York, Asia/Tokyo. Default if unset: UTC.
TIMEZONE=UTC

# Required. From your Oura application (https://cloud.ouraring.com/oauth/applications).
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret

# Required. Added automatically by Vercel when you connect a private Blob store to the project.
# BLOB_READ_WRITE_TOKEN=added-automatically-by-vercel

# Optional. Only needed with a custom domain. Default: the project's production *.vercel.app address.
# PUBLIC_BASE_URL=https://oura.example.com

# Optional. Oura scopes to request. Default:
# OURA_SCOPES=email personal daily heartrate workout
